[Desktop Entry]
Type=Application
Version=1.5
Name=BlackPDF
GenericName=PDF editor
GenericName[es]=Editor de PDF
GenericName[pt]=Editor de PDF
GenericName[pt_BR]=Editor de PDF
GenericName[fr]=Éditeur PDF
Comment=Free and open PDF viewer and editor that works offline
Comment[es]=Visor y editor de PDF libre, gratuito y sin conexión
Comment[pt]=Visualizador e editor de PDF livre, gratuito e sem ligação à Internet
Comment[pt_BR]=Visualizador e editor de PDF livre, gratuito e sem conexão
Comment[fr]=Visionneuse et éditeur PDF libre, gratuit et hors ligne
Exec=blackpdf %F
Icon=blackpdf
Terminal=false
StartupNotify=true
StartupWMClass=BlackPDF
Categories=Office;Viewer;Graphics;
MimeType=application/pdf;application/x-pdf;image/png;image/jpeg;image/tiff;
Keywords=pdf;merge;split;compress;sign;annotate;ocr;3d;
Keywords[es]=pdf;unir;dividir;comprimir;firmar;anotar;ocr;3d;
